     def Spin(self, angle):
         self.target_angle = radians(angle)
         self.odom_angle = self.get_odom_angle()
+        # Spin() is only called during corners, so last_angle goes stale along the
+        # straight sides. Without this, the first delta of each corner is the
+        # PREVIOUS corner's spin-down coast plus any drift, which is counted as
+        # progress and makes corners 2..n stop short by exactly that amount.
+        if self.spin_fresh:
+            self.last_angle = self.odom_angle
+            self.spin_fresh = False
         self.delta_angle = self.RotationScaling * self.normalize_angle(
             self.odom_angle - self.last_angle
         )
