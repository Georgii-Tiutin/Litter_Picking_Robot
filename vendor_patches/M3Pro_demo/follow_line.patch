+	def remoteKeyCallback(self, msg):
+		# 32=space/start, 105=i, 114=r, 113=q, 0=explicit stop
+		if msg.data == 0:
+			self.Track_state = "identify"
+			for i in range(5): self.pub_cmdVel.publish(Twist())
+			# execute() normally clears the buzzer, but it stops being called once
+			# tracking ends - so clear it here or it rings forever
+			b = UInt16()
+			b.data = 0
+			for i in range(3): self.pub_Buzzer.publish(b)
+			self.Buzzer_state = False
+			print("remote: STOP")
+		else:
+			self.remote_action = int(msg.data)
+			print("remote: action", msg.data)
+
